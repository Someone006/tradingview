# CiteBeam configuration. Copy to .env and fill in what you have.
# The site readiness crawl works with NO keys at all - these only enable
# live answer-visibility measurement.

# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# PERPLEXITY_API_KEY=pplx-...
# GEMINI_API_KEY=...

# Optional model overrides
# CITEBEAM_OPENAI_MODEL=gpt-4o-mini
# CITEBEAM_ANTHROPIC_MODEL=claude-sonnet-4-5
# CITEBEAM_PERPLEXITY_MODEL=sonar
# CITEBEAM_GEMINI_MODEL=gemini-2.0-flash

# Server
# PORT=4317

# Storage
# CITEBEAM_DATA_DIR=data
# CITEBEAM_OUT_DIR=audits

# Audit defaults
# CITEBEAM_MAX_PAGES=12
# CITEBEAM_PROMPT_COUNT=24
# Repeat asks per prompt (1-10). Raises measurement quality and cost together.
# CITEBEAM_SAMPLES=1
# CITEBEAM_CRAWL_CONCURRENCY=4
# CITEBEAM_ENGINE_CONCURRENCY=3

# Set to any value to log HTTP requests
# CITEBEAM_ACCESS_LOG=1

# Swiss data protection (revFADP). Named in `citebeam privacy register`.
# CITEBEAM_CONTROLLER="Your Company GmbH, Bahnhofstrasse 1, 8001 Zurich"
# CITEBEAM_DPO_CONTACT=privacy@yourcompany.ch
# Retention window in days for stored audit runs.
# CITEBEAM_RETENTION_DAYS=730
